# Copy to .env and adjust. Never commit the real .env.
#
#   cp .env.example .env
#   # generate a strong secret:
#   echo "SUPERSET_SECRET_KEY=$(openssl rand -base64 42)" >> .env

# REQUIRED: Flask secret key (sessions, CSRF, encrypted fields)
SUPERSET_SECRET_KEY=change_me_openssl_rand_base64_42

# Metadata Postgres password
DATABASE_PASSWORD=superset

# Public HTTP port exposed by nginx
HTTP_PORT=80

# Branding
SUPERSET_APP_NAME=DataHub Analytics

# Dashboard shown as the start page for every logged-in user (PR: feat/start-dashboard)
SUPERSET_DEFAULT_DASHBOARD_ID=1

# First-run bootstrap (init service)
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_LOAD_EXAMPLES=yes

# Set true when serving over HTTPS so the session cookie gets the Secure flag
SESSION_COOKIE_SECURE=false
